{
  "name": "@omnidotdev/vortex-events",
  "version": "0.1.0",
  "description": "Publish events to the Vortex workflow hub",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "keywords": ["vortex", "events", "sdk", "typescript"],
  "license": "MIT"
}
