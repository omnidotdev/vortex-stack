# ============================================================
# Vortex Environment Configuration
# ============================================================
# Copy to .env.local and fill in values before running:
#   cp .env.local.template .env.local
#
# Generate secrets with:
#   AUTH_SECRET:         openssl rand -hex 16
#   ENCRYPTION_KEY:      openssl rand -base64 32
#   INTERNAL_API_SECRET: openssl rand -hex 16
#   DB_PASSWORD:         openssl rand -hex 16
#   CACHE_PASSWORD:      openssl rand -hex 16

# ------------------------------------------------------------
# Required - services will not start without these
# ------------------------------------------------------------

DB_PASSWORD=changeme
CACHE_PASSWORD=changeme
AUTH_SECRET=changeme
ENCRYPTION_KEY=changeme
INTERNAL_API_SECRET=changeme
IGGY_USERNAME=changeme
IGGY_PASSWORD=changeme

# Hatchet workflow engine - required for the default executor backend.
# Run Hatchet locally (https://docs.hatchet.run/self-hosting) or use
# Hatchet Cloud, then paste the generated client token here.
HATCHET_CLIENT_TOKEN=changeme

# ------------------------------------------------------------
# Optional - infrastructure defaults
# ------------------------------------------------------------

# Database connection (defaults shown)
# DB_NAME=vortex
# DB_USER=postgres
# DB_PORT=5432

# Service ports (defaults shown)
# API_PORT=4000
# APP_PORT=3000
# CACHE_PORT=6379
# EVENTS_TCP_PORT=8090

# Hatchet TLS strategy: "none", "tls", or "mtls" (default: none)
# HATCHET_CLIENT_TLS_STRATEGY=none

# CORS origins for the API (default: http://localhost:3000)
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Public URL used in webhook callback URLs (default: http://localhost:4000)
# VORTEX_PUBLIC_URL=http://localhost:4000

# Base URL for OAuth callback redirects (default: http://localhost:3000)
# VORTEX_CALLBACK_BASE_URL=http://localhost:3000

# Platform org ID for multi-tenant deployments (default: empty, single-tenant)
# PLATFORM_ORG_ID=

# ------------------------------------------------------------
# Optional - OAuth providers (email/password always available)
# Omit to disable the corresponding login method
# ------------------------------------------------------------

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Generic OIDC provider (e.g. Keycloak, Auth0, HIDRA)
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# ------------------------------------------------------------
# Optional - Omni platform integrations
# Omit to run Vortex standalone without these features
# ------------------------------------------------------------

# Mantle (notification service) - omit to disable workflow notifications
# MANTLE_API_URL=
# MANTLE_SERVICE_KEY=

# Identity provider (Gatekeeper/OIDC) base URL - required for the API to
# validate JWTs server-side (JWKS + userinfo). Must point to a reachable
# Gatekeeper/OIDC provider, NOT the vortex-app service. There is no identity
# provider bundled in this compose stack; run one separately or use a hosted
# OIDC provider.
AUTH_BASE_URL=https://gatekeeper.example.com

# HIDRA (identity provider) - omit to use built-in auth only
# AUTH_API_URL=

# Email trigger adapter - omit to disable email-triggered workflows
# EMAIL_RENDER_SECRET=

# Outbound email via Herald - omit to log sends to stdout instead
# HERALD_API_URL=
# HERALD_API_KEY=
# HERALD_SENDER_EMAIL_ADDRESS=
# HERALD_SEND_ENABLED=
